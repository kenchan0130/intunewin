{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>aquaproj/aqua-renovate-config#2.8.0"
  ],
  "schedule": [
    "before 9am on the first day of the month"
  ],
  "packageRules": [
    {
      "groupName": "Go dependencies (minor/patch)",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    }
  ]
}